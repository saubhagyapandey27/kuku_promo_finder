# Public, non-secret BUILD-TIME configuration only.
# Provider keys and passcodes never belong in VITE_* (they would enter the bundle).

# Browser API base. Leave unset for local Vite proxy (relative /api).
# For GitHub Pages + Render set the public API origin, e.g.:
# VITE_API_BASE_URL=https://your-api.onrender.com/api

# Vite base path for a GitHub Pages project site (must match the repo name).
# The deploy workflow sets this automatically; locally you can set it to test:
# VITE_BASE=/<repository-name>/

# ---- Local development only (set in the terminal, NOT baked into a public build) ----
# PF_DEV_TLS_CERT=D:/private-certs/localhost.pem
# PF_DEV_TLS_KEY=D:/private-certs/localhost-key.pem
# PF_DEV_API_ORIGIN=https://localhost:8000
# NODE_EXTRA_CA_CERTS=D:/private-certs/rootCA.pem
