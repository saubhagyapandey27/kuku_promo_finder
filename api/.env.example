# Set in the process environment (this file is documentation, not auto-loaded).
# Public prototype defaults: the frontend is bundled with safe derived results
# and opens without the API. New runs use visitor-supplied keys.
PF_PRIVATE=0
PF_LIVE_ENABLED=0
# Visitor-funded jobs use their own keys, not server keys or PF_LIVE_ENABLED.
PF_VISITOR_KEYS_ENABLED=1
# External, persistent working directory for jobs; never inside the repo.
PF_RUNS_DIR=D:/path/to/external/persistent/web-runs
PF_REMOTE=0
# GitHub Pages -> Render cross-origin: the exact Pages ORIGIN (scheme + host,
# NO path, NO trailing slash), e.g. https://your-username.github.io . It must
# equal the browser's Origin header; it enables CORS and SameSite=None;Secure
# session cookies for the cross-site frontend. Provider keys never go here.
PF_ALLOWED_ORIGIN=https://your-username.github.io
# Required for remote sessions; use a long random secret.
PF_SESSION_SECRET=replace-with-random-secret
# Remote jobs require real persistent storage. Each visitor enters their own spend cap.
PF_PERSISTENT_STORAGE=0
